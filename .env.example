# Copy to .env.local and fill in. Never commit .env.local.

# Required for "Read plan with Claude" (Phase 1) and the AI assistant (Phase 4).
# Server-side only — it is read in the /api/extract-plan route and never sent
# to the browser.
ANTHROPIC_API_KEY=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

# Optional. Without these the app stores everything in the browser (IndexedDB),
# which is fine for a single machine. Set both to sync projects, plan images and
# model versions through Supabase; apply supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
